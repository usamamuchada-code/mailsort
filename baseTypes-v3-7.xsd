			<xs:element ref="Title" minOccurs="0"/>
			<xs:element ref="Surname"/>
			<xs:element ref="Forename" minOccurs="0"/>
			<xs:element ref="OtherForenames" minOccurs="0"/>
			<xs:element ref="DOB" minOccurs="0"/>
			<xs:element ref="Nationality" minOccurs="0"/>
			<xs:element ref="PersonID" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PersonBaseType">
		<xs:sequence>
			<xs:element ref="Title" minOccurs="0"/>
			<xs:element ref="Forename" minOccurs="0"/>
			<xs:element ref="OtherForenames" minOccurs="0">
