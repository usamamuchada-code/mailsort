		<xs:annotation>
			<xs:documentation>Additional persons entitled indicator</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="true"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="PersonsEntitled" type="xs:string">
