		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="nonEmptyNameAddressString">
				<xs:minLength value="1"/>
				<xs:maxLength value="50"/>
				<xs:whiteSpace value="collapse"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="PoBox">
		<xs:annotation>
			<xs:documentation>PO Box</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="nameAddressString">
				<xs:maxLength value="10"/>
			</xs:restriction>
		</xs:simpleType>
