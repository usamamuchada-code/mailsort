				<xs:element ref="Surname"/>
				<xs:element ref="DOB"/>
				<xs:element ref="PostTown"/>
				<xs:element ref="PostCode"/>
				<xs:element ref="Postcode"/>
				<xs:element ref="PersonID"/>
			</xs:sequence>
		</xs:complexType>
