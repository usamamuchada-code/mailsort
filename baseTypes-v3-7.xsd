				<xs:maxLength value="3500"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Description" type="otherDataString">
		<xs:annotation>
			<xs:documentation>Description</xs:documentation>
		</xs:annotation>
	</xs:element>
