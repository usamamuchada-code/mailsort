				</xs:enumeration>
				<xs:enumeration value="RESIGNED">
					<xs:annotation>
						<xs:documentation>This is a resigned appointment</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
			</xs:restriction>
		</xs:simpleType>
