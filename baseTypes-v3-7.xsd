			<xs:restriction base="xs:string">
				<xs:enumeration value="DIR">
					<xs:annotation>
						<xs:documentation>This appointment is for a Director</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="SEC">
					<xs:annotation>
						<xs:documentation>This appointment is for a Secretary</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="NOMDIR">
					<xs:annotation>
						<xs:documentation>This appointment is for a Nominated Director</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="NOMSEC">
					<xs:annotation>
						<xs:documentation>This appointment is for a Nominated Secretary</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="DIRSEC">
					<xs:annotation>
						<xs:documentation>This appointment is both a Director and a Secretary</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="DESMEM">
					<xs:annotation>
						<xs:documentation>This appointment is a Designated Member</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
				<xs:enumeration value="MEMBER">
					<xs:annotation>
						<xs:documentation>This appointment is a Member</xs:documentation>
					</xs:annotation>
				</xs:enumeration>
			</xs:restriction>
