			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="NumDissolvedAppt">
		<xs:annotation>
			<xs:documentation>The number of dissolved appointments</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:integer">
				<xs:minInclusive value="0"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="NumAppointments">
