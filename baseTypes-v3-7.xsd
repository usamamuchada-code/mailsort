					<xs:documentation>More than one name can be entered separated by spaces</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="Surname"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PersonReturnType">
		<xs:sequence>
			<xs:element ref="Title" minOccurs="0"/>
			<xs:element ref="Forename" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element ref="Surname"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="NameType">
		<xs:sequence minOccurs="0">
			<xs:element ref="Forename"/>
			<xs:element ref="Surname"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PreviousNameType">
		<xs:sequence>
			<xs:element ref="Forename" minOccurs="0"/>
			<xs:element name="Surname">
				<xs:simpleType>
					<xs:restriction base="nonEmptyString">
						<xs:maxLength value="50"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="PersonNameType">
		<xs:sequence>
			<xs:element ref="Forename" minOccurs="0"/>
			<xs:element name="Surname" type="nonEmptyNameAddressString"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="AddressTypeX"/>
	<xs:complexType name="CompanyAddressType">
		<xs:complexContent>
			<xs:extension base="AddressBaseType">
				<xs:sequence>
					<xs:element ref="CareofName" minOccurs="0"/>
					<xs:element ref="PoBox" minOccurs="0"/>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
