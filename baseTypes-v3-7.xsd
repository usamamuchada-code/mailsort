		<xs:simpleType>
			<xs:restriction base="xs:integer">
				<xs:minInclusive value="0"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Surname">
		<xs:simpleType>
			<xs:restriction base="nonEmptyNameAddressString">
				<xs:minLength value="1"/>
				<xs:maxLength value="160"/>
				<xs:whiteSpace value="collapse"/>
