		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="nameAddressString">
				<xs:maxLength value="50"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Country">
		<xs:annotation>
			<xs:documentation>Address Country</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="nameAddressString">
				<xs:maxLength value="50"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Postcode">
		<xs:annotation>
			<xs:documentation>Address Postcode</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="nameAddressString">
				<xs:maxLength value="15"/>
				<xs:minLength value="0"/>
