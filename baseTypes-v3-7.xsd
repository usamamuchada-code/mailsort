		<xs:annotation>
			<xs:documentation>Person entitled to charge Name</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SatisfiedDate" type="xs:date">
		<xs:annotation>
			<xs:documentation>Satisfication Date</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="ExistingChargeKey">
		<xs:annotation>
			<xs:documentation>Charge specific identification key returned by read to be used in submission</xs:documentation>
		</xs:annotation>
	</xs:element>
